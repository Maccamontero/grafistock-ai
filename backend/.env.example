# ── Variables del backend de grafistock-ai ────────────────────────────
# Copia este archivo como .env y rellena los valores reales.
# El .env real está cubierto por .gitignore — nunca lo commitees.

# API key del LLM (Anthropic Claude). Obténla en https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Puerto del servidor.
# - Local: 3001 (el proxy de Vite del frontend apunta a este puerto).
# - Producción (AWS App Runner): la plataforma inyecta PORT=8080. No lo fijes en el .env de producción.
PORT=3001

# Origen permitido por CORS (URL del frontend).
# - Local: http://localhost:3000
# - Producción: la URL pública del frontend (CloudFront).
CORS_ORIGIN=http://localhost:3000

# ── Autenticación ─────────────────────────────────────────────────────
# Credenciales del único usuario administrativo y secreto para firmar JWTs.
# En producción: NUNCA pongas valores acá. Crea 3 secretos en AWS Secrets Manager
# (grafistock/admin-user, grafistock/admin-password, grafistock/jwt-secret) y
# referéncialos desde App Runner como variables secretas.
# Para JWT_SECRET en producción usa una cadena random de 128+ chars hex
# (ej. `openssl rand -hex 64`).
ADMIN_USER=
ADMIN_PASSWORD=
JWT_SECRET=

# ── Logging ───────────────────────────────────────────────────────────
# Nivel de log del backend.
# - vacío (o sin la variable): el backend solo imprime "Backend running on :PORT"
#   y errores genuinos. Recomendado en producción para no filtrar cifras
#   comerciales en CloudWatch.
# - "debug": imprime el log completo del pipeline (clasificación, RunRate,
#   Top 10, validaciones). Útil en dev local.
LOG_LEVEL=debug
